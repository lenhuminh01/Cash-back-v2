    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\nimport { PlatformType, ConvertedLink, PlatformConfig } from \'../types\';\n\nexport function cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\nexport const PLATFORMS: Record<PlatformType, PlatformConfig> = {\n  shopee: {\n    id: \'shopee\',\n    name: \'Shopee\',\n    domains: [\'shopee.\', \'shope.ee\'],\n    color: \'#EE4D2D\',\n    bgLight: \'bg-orange-50 hover:bg-orange-100\',\n    bgDark: \'dark:bg-orange-950/30 dark:hover:bg-orange-950/50\',\n    textLight: \'text-orange-600\',\n    textDark: \'dark:text-orange-400\',\n    borderLight: \'border-orange-200\',\n    borderDark: \'dark:border-orange-800/40\',\n    defaultRate: 8.5,\n    sampleUrl: \'https://shopee.vn/product/12345678/987654321?spm=123&utm_source=test\',\n  },\n  tiktok: {\n    id: \'tiktok\',\n    name: \'TikTok Shop\',\n    domains: [\'tiktok.com\', \'vt.tiktok.com\', \'shop.tiktok.com\', \'vm.tiktok.com\'],\n    color: \'#00F2FE\',\n    bgLight: \'bg-teal-50 hover:bg-teal-100\',\n    bgDark: \'dark:bg-teal-950/30 dark:hover:bg-teal-950/50\',\n    textLight: \'text-teal-700\',\n    textDark: \'dark:text-teal-300\',\n    borderLight: \'border-teal-200\',\n    borderDark: \'dark:border-teal-800/40\',\n    defaultRate: 12.0,\n    sampleUrl: \'https://vt.tiktok.com/ZSrP9x2K/?_t=8x9lK2&enter_from=share\',\n  },\n  lazada: {\n    id: \'lazada\',\n    name: \'Lazada\',\n    domains: [\'lazada.\', \'s.lazada.co\'],\n    color: \'#0F146D\',\n    bgLight: \'bg-indigo-50 hover:bg-indigo-100\',\n    bgDark: \'dark:bg-indigo-950/30 dark:hover:bg-indigo-950/50\',\n    textLight: \'text-indigo-700\',\n    textDark: \'dark:text-indigo-300\',\n    borderLight: \'border-indigo-200\',\n    borderDark: \'dark:border-indigo-800/40\',\n    defaultRate: 6.5,\n    sampleUrl: \'https://www.lazada.vn/products/audio-wireless-earbuds-i10928374.html?spm=a2o4n&exlaz=test\',\n  },\n  unknown: {\n    id: \'unknown\',\n    name: \'Unknown Platform\',\n    domains: [],\n    color: \'#6B7280\',\n    bgLight: \'bg-gray-50\',\n    bgDark: \'dark:bg-gray-900\',\n    textLight: \'text-gray-600\',\n    textDark: \'dark:text-gray-400\',\n    borderLight: \'border-gray-200\',\n    borderDark: \'dark:border-gray-800\',\n    defaultRate: 5.0,\n    sampleUrl: \'\',\n  },\n};\n\nexport function detectPlatform(url: string): PlatformType {\n  if (!url || typeof url !== \'string\') return \'unknown\';\n  const cleanUrl = url.trim().toLowerCase();\n\n  if (cleanUrl.includes(\'shopee.\') || cleanUrl.includes(\'shope.ee\')) {\n    return \'shopee\';\n  }\n  if (\n    cleanUrl.includes(\'tiktok.com\') ||\n    cleanUrl.includes(\'vt.tiktok.com\') ||\n    cleanUrl.includes(\'shop.tiktok.com\') ||\n    cleanUrl.includes(\'vm.tiktok.com\')\n  ) {\n    return \'tiktok\';\n  }\n  if (cleanUrl.includes(\'lazada.\') || cleanUrl.includes(\'s.lazada.co\')) {\n    return \'lazada\';\n  }\n\n  return \'unknown\';\n}\n\nexport function isValidUrl(urlStr: string): boolean {\n  try {\n    const formatted = urlStr.trim().startsWith(\'http\') ? urlStr.trim() : `https://${urlStr.trim()}`;\n    const parsed = new URL(formatted);\n    return parsed.hostname.includes(\'.\');\n  } catch {\n    return false;\n  }\n}\n\nexport function normalizeUrl(url: string, platform: PlatformType): string {\n  let cleanInput = url.trim();\n  if (!cleanInput.startsWith(\'http://\') && !cleanInput.startsWith(\'https://\')) {\n    cleanInput = `https://${cleanInput}`;\n  }\n\n  try {\n    const parsed = new URL(cleanInput);\n\n    if (platform === \'shopee\') {\n      // Remove noisy params\n      const allowedParams = new Set([\'shopid\', \'itemid\']);\n      const searchParams = new URLSearchParams();\n      parsed.searchParams.forEach((val, key) => {\n        if (allowedParams.has(key.toLowerCase())) {\n          searchParams.append(key, val);\n        }\n      });\n      parsed.search = searchParams.toString();\n      return parsed.toString();\n    }\n\n    if (platform === \'tiktok\') {\n      // Clean query params like _t, _r, enter_from\n      parsed.search = \'\';\n      return parsed.toString();\n    }\n\n    if (platform === \'lazada\') {\n      // Keep product path, clear tracking params\n      parsed.search = \'\';\n      return parsed.toString();\n    }\n\n    // Default cleanup\n    parsed.search = \'\';\n    return parsed.toString();\n  } catch {\n    return cleanInput;\n  }\n}\n\nexport function generateHash(str: string): string {\n  let hash = 0;\n  for (let i = 0; i < str.length; i++) {\n    hash = (hash << 5) - hash + str.charCodeAt(i);\n    hash |= 0;\n  }\n  const positive = Math.abs(hash).toString(36);\n  return (positive + \'x9k2m7q\').slice(0, 6);\n}\n\nexport function generateAffiliateLink(\n  originalUrl: string,\n  platform: PlatformType,\n  subId: string = \'cashback_user\'\n): { affiliateUrl: string; shortUrl: string; title: string; category: string; estimatedPrice: number; estimatedCashback: number; commissionRate: number } {\n  const normalized = normalizeUrl(originalUrl, platform);\n  const hash = generateHash(originalUrl + Date.now().toString());\n  const tag = subId.trim() || \'cashback_app\';\n\n  let affiliateUrl = \'\';\n  let shortUrl = \'\';\n  let defaultRate = 8.5;\n\n  if (platform === \'shopee\') {\n    defaultRate = 8.5;\n    affiliateUrl = `${normalized}${normalized.includes(\'?\') ? \'&\' : \'?\'}af_siteid=cashbacklink&sub_id=${encodeURIComponent(tag)}&utm_content=cb_${hash}`;\n    shortUrl = `https://shope.ee/cb_${hash}`;\n  } else if (platform === \'tiktok\') {\n    defaultRate = 12.0;\n    affiliateUrl = `${normalized}${normalized.includes(\'?\') ? \'&\' : \'?\'}affiliate_id=cblink_${hash}&sub_id=${encodeURIComponent(tag)}`;\n    shortUrl = `https://vt.tiktok.com/cb_${hash}`;\n  } else if (platform === \'lazada\') {\n    defaultRate = 6.5;\n    affiliateUrl = `${normalized}${normalized.includes(\'?\') ? \'&\' : \'?\'}aff_channel=cashbacklink&sub_id1=${encodeURIComponent(tag)}&click_id=laz_${hash}`;\n    shortUrl = `https://s.lazada.co/cb_${hash}`;\n  } else {\n    defaultRate = 5.0;\n    affiliateUrl = `${normalized}${normalized.includes(\'?\') ? \'&\' : \'?\'}aff_id=generic_${hash}&sub=${encodeURIComponent(tag)}`;\n    shortUrl = `https://cblink.app/cb_${hash}`;\n  }\n\n  // Generate plausible product details from URL for MVP interactive feel\n  const mockCategories = [\'Fashion & Beauty\', \'Electronics & Gadgets\', \'Home & Living\', \'Mother & Baby\', \'Health & Wellness\'];\n  const category = mockCategories[Math.abs(generateHash(originalUrl).charCodeAt(0)) % mockCategories.length];\n  \n  // Plausible estimated item price range ($15 - $120) based on hash\n  const priceSeed = (Math.abs(generateHash(originalUrl).charCodeAt(1) || 45) % 100) + 15;\n  const estimatedPrice = Number(priceSeed.toFixed(2));\n  \n  // Rate based on platform + category variance\n  const categoryBonus = category === \'Fashion & Beauty\' ? 3.5 : category === \'Electronics & Gadgets\' ? -1.5 : 0;\n  const commissionRate = Number(Math.max(3.0, defaultRate + categoryBonus).toFixed(1));\n  const estimatedCashback = Number(((estimatedPrice * commissionRate) / 100).toFixed(2));\n\n  // Extract a friendly title if available\n  let title = \'Popular E-Commerce Product\';\n  try {\n    const urlObj = new URL(originalUrl.startsWith(\'http\') ? originalUrl : `https://${originalUrl}`);\n    const pathnameParts = urlObj.pathname.split(\'/\').filter(Boolean);\n    const lastPart = pathnameParts[pathnameParts.length - 1] || \'\';\n    if (lastPart && !lastPart.match(/^(i\\d+|\\d+)$/i)) {\n      const cleanTitle = lastPart\n        .replace(/\\.html$/i, \'\')\n        .replace(/[-_]+/g, \' \')\n        .replace(/\\b\\w/g, (l) => l.toUpperCase());\n      if (cleanTitle.length > 5) {\n        title = cleanTitle.length > 45 ? cleanTitle.slice(0, 42) + \'...\' : cleanTitle;\n      }\n    }\n  } catch {\n    // fallback title\n  }\n\n  return {\n    affiliateUrl,\n    shortUrl,\n    title,\n    category,\n    estimatedPrice,\n    estimatedCashback,\n    commissionRate,\n  };\n}\n\nexport function formatCurrency(amount: number, currencySymbol: string = \'$\'): string {\n  return `${currencySymbol}${amount.toLocaleString(\'en-US\', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n}\n\nexport async function copyToClipboard(text: string): Promise<boolean> {\n  if (!navigator.clipboard) {\n    try {\n      const textarea = document.createElement(\'textarea\');\n      textarea.value = text;\n      textarea.style.position = \'fixed\';\n      textarea.style.opacity = \'0\';\n      document.body.appendChild(textarea);\n      textarea.focus();\n      textarea.select();\n      const successful = document.execCommand(\'copy\');\n      document.body.removeChild(textarea);\n      return successful;\n    } catch {\n      return false;\n    }\n  }\n\n  try {\n    await navigator.clipboard.writeText(text);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nexport const SAMPLE_URLS = [\n  {\n    platform: \'shopee\' as PlatformType,\n    label: \'Shopee Vietnam - Wireless Earbuds\',\n    url: \'https://shopee.vn/product/12345678/987654321?spm=123.456.789&utm_source=facebook_ad\',\n  },\n  {\n    platform: \'tiktok\' as PlatformType,\n    label: \'TikTok Shop - Trendy Oversized Hoodie\',\n    url: \'https://vt.tiktok.com/ZSrP9x2K/?_t=8x9lK2&enter_from=share_link\',\n  },\n  {\n    platform: \'lazada\' as PlatformType,\n    label: \'Lazada Philippines - Smart Fitness Watch\',\n    url: \'https://www.lazada.com.ph/products/smart-fitness-tracker-watch-i90827361.html?spm=a2o4l.searchlist\',\n  },\n];\n"
    }
