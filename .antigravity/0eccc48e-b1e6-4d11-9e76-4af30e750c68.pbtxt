    instruction: "Update HistoryList component with Professional Polish styling theme"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"w-full bg-white dark:bg-gray-900 rounded-2xl p-4 sm:p-6 shadow-xl border border-gray-200/80 dark:border-gray-800 space-y-4 transition-all\">\n      {/* Header Bar */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-gray-100 dark:border-gray-800\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"p-2 rounded-xl bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400\">\n            <History className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h3 className=\"font-bold text-base text-gray-900 dark:text-white flex items-center gap-2\">\n              Conversion History\n              <span className=\"text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 font-medium\">\n                {history.length} Saved\n              </span>\n            </h3>\n            <p className=\"text-xs text-gray-500 dark:text-gray-400\">\n              Stored locally in your browser cache\n            </p>\n          </div>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2\">\n          {history.length > 0 && (\n            <>\n              <button\n                onClick={handleExportCsv}\n                className=\"px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-700 transition-colors flex items-center gap-1 cursor-pointer\"\n                title=\"Export CSV\"\n              >\n                <Download className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Export CSV</span>\n              </button>\n\n              <button\n                onClick={onClearHistory}\n                className=\"px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 transition-colors flex items-center gap-1 cursor-pointer\"\n                title=\"Clear all history\"\n              >\n                <Trash2 className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Clear All</span>\n              </button>\n            </>\n          )}\n        </div>\n      </div>\n\n      {/* Stats Summary Bar */}\n      {history.length > 0 && (\n        <div className=\"p-3 rounded-xl bg-gradient-to-r from-orange-500/10 via-rose-500/10 to-indigo-500/10 border border-orange-200/60 dark:border-orange-900/40 flex items-center justify-between text-xs\">\n          <div className=\"flex items-center gap-2\">\n            <TrendingUp className=\"w-4 h-4 text-orange-500\" />\n            <span className=\"text-gray-700 dark:text-gray-300\">Total Est. Cashback Potential:</span>\n          </div>\n          <span className=\"font-extrabold text-sm text-gray-900 dark:text-white\">\n            {formatCurrency(totalCashbackEst)}\n          </span>\n        </div>\n      )}\n\n      {/* Filters & Search */}\n      {history.length > 0 && (\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-2.5\">\n          {/* Search Field */}\n          <div className=\"relative w-full sm:w-64\">\n            <Search className=\"w-3.5 h-3.5 text-gray-400 absolute left-3 top-2.5\" />\n            <input\n              type=\"text\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              placeholder=\"Search history by title, URL or SubID...\"\n              className=\"w-full py-1.5 pl-8 pr-3 text-xs rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-500/30\"\n            />\n         