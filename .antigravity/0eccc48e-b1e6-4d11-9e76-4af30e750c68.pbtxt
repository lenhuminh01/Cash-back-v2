    instruction: "Update QrCodeModal component with Professional Polish styling theme"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs\">\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 10 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.95, y: 10 }}\n          className=\"relative w-full max-w-md bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800 overflow-hidden\"\n        >\n          {/* Header */}\n          <div className=\"flex items-center justify-between p-4 border-b border-gray-100 dark:border-gray-800\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"p-2 rounded-lg bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400\">\n                <QrCode className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h3 className=\"font-bold text-sm text-gray-900 dark:text-white\">\n                  Affiliate QR Code Generator\n                </h3>\n                <p className=\"text-xs text-gray-500 dark:text-gray-400\">\n                  {platformInfo.name} \342\200\242 {link.shortUrl}\n                </p>\n              </div>\n            </div>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* QR Code Canvas Display Container */}\n          <div className=\"p-6 flex flex-col items-center justify-center bg-gray-50 dark:bg-gray-950/50\">\n            <div\n              ref={canvasRef}\n              className=\"p-4 bg-white rounded-2xl shadow-lg border border-gray-200/80 dark:border-gray-800 flex items-center justify-center\"\n              style={{ backgroundColor: bgColor }}\n            >\n              <QRCodeCanvas\n                value={link.shortUrl}\n                size={qrSize}\n                bgColor={bgColor}\n                fgColor={fgColor}\n                level=\"H\"\n                includeMargin={true}\n                imageSettings={\n                  includeLogo\n                    ? {\n                        src: \'data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"%23EE4D2D\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\',\n                        x: undefined,\n                        y: undefined,\n                        height: 36,\n                        width: 36,\n                        excavate: true,\n                      }\n                    : undefined\n                }\n              />\n            </div>\n            <p className=\"mt-3 text-xs text-center text-gray-500 dark:text-gray-400 max-w-xs font-mono truncate\">\n              {link.shortUrl}\n            </p>\n          </div>\n\n          {/* QR Code Customization Controls */}\n          <div className=\"p-4 space-y-3 bg-white dark:bg-gray-900\">\n            {/* Color Presets */}\n            <div className=\"flex items-center justify-between text-xs\">\n              <span className=\"font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1\">\n                <Palette className=\"w-3.5 h-3.5 text-orange-500\" />\n                Color Theme:\n              </span>\n              <div className=\"flex items-center gap-1.5\">\n                <button\n                  onClick={() => { setFgColor(\'#0f172a\'); setBgColor(\'#ffffff\'); }}\n                  className=\"w-5 h-5 rounded-full bg-slate-900 border border-gray-300\"\n                  title=\"Dark / Light\"\n                />\n                <button\n                  onClick={() => { setFgColor(\'#EE4D2D\'); setBgColor(\'#fff7ed\'); }}\n                  className=\"w-5 h-5 rounded-full bg-orange-600 border border-gray-300\"\n                  title=\"Shopee Orange\"\n                />\n                <button\n                  onClick={() => { setFgColor(\'#0f766e\'); setBgColor(\'#f0fdf4\'); }}\n                  className=\"w-5 h-5 rounded-full bg-teal-600 border border-gray-300\"\n                  title=\"TikTok Teal\"\n                />\n                <button\n                  onClick={() => { setFgColor(\'#3730a3\'); setBgColor(\'#eef2ff\'); }}\n                  className=\"w-5 h-5 rounded-full bg-indigo-700 border border-gray-300\"\n                  title=\"Lazada Indigo\"\n                />\n              </div>\n            </div>\n\n            {/* Include Logo Toggle */}\n            <div className=\"flex items-center justify-between text-xs pt-1 border-t border-gray-100 dark:border-gray-800\">\n              <span className=\"font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1\">\n                <ImageIcon className=\"w-3.5 h-3.5 text-indigo-500\" />\n                Center Icon Badge:\n              </span>\n              <button\n                onClick={() => setIncludeLogo(!includeLogo)}\n                className={`px-2.5 py-1 rounded-md text-xs font-semibold transition-colors ${\n                  includeLogo\n                    ? \'bg-orange-100 dark:bg-orange-950/60 text-orange-700 dark:text-orange-300\'\n                    : \'bg-gray-100 dark:bg-gray-800 text-gray-500\'\n                }`}\n              >\n                {includeLogo ? \'Enabled\' : \'Disabled\'}\n              </button>\n            </div>\n\n            {/* Download & Copy Buttons */}\n            <div className=\"grid grid-cols-2 gap-2 pt-2\">\n              <button\n                onClick={handleCopyUrl}\n                className=\"py-2.5 px-3 rounded-xl text-xs font-semibold bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 transition-colors flex items-center justify-center gap-1.5 cursor-pointer\"\n              >\n                {copied ? <Check className=\"w-4 h-4 text-emerald-500\" /> : <Copy className=\"w-4 h-4\" />}\n                <span>{copied ? \'Copied Link\' : \'Copy Link\'}</span>\n              </button>\n\n              <button\n                onClick={handleDownloadPng}\n                className=\"py-2.5 px-3 rounded-xl text-xs font-bold text-white bg-orange-500 hover:bg-orange-600 transition-colors flex items-center justify-center gap-1.5 shadow-md shadow-orange-500/20 cursor-pointer\"\n              >\n                <Download className=\"w-4 h-4\" />\n                <span>Download PNG</span>\n              </button>\n            </div>\n          </div>\n        </motion.div>\n      </div>\n    </AnimatePresence>\n  );"
        replacement_content: "  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs\">\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 10 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.95, y: 10 }}\n          className=\"relative w-full max-w-md bg-white dark:bg-zinc-900 rounded-2xl shadow-2xl border border-zinc-200 dark:border-zinc-800 overflow-hidden\"\n        >\n          {/* Header */}\n          <div className=\"flex items-center justify-between p-4 border-b border-zinc-100 dark:border-zinc-800\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"p-2 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20\">\n                <QrCode className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h3 className=\"font-bold text-sm text-zinc-900 dark:text-white\">\n                  Affiliate QR Code Generator\n                </h3>\n                <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">\n                  {platformInfo.name} \342\200\242 {link.shortUrl}\n                </p>\n              </div>\n            </div>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded-lg text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          {/* QR Code Canvas Display Container */}\n          <div className=\"p-6 flex flex-col items-center justify-center bg-zinc-50 dark:bg-zinc-950/60\">\n            <div\n              ref={canvasRef}\n              className=\"p-4 bg-white rounded-2xl shadow-lg border border-zinc-200 dark:border-zinc-800 flex items-center justify-center\"\n              style={{ backgroundColor: bgColor }}\n            >\n              <QRCodeCanvas\n                value={link.shortUrl}\n                size={qrSize}\n                bgColor={bgColor}\n                fgColor={fgColor}\n                level=\"H\"\n                includeMargin={true}\n                imageSettings={\n                  includeLogo\n                    ? {\n                        src: \'data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"%232563eb\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\',\n                        x: undefined,\n                        y: undefined,\n                        height: 36,\n                        width: 36,\n                        excavate: true,\n                      }\n                    : undefined\n                }\n              />\n            </div>\n            <p className=\"mt-3 text-xs text-center text-zinc-500 dark:text-zinc-400 max-w-xs font-mono truncate\">\n              {link.shortUrl}\n            </p>\n          </div>\n\n          {/* QR Code Customization Controls */}\n          <div className=\"p-4 space-y-3 bg-white dark:bg-zinc-900\">\n            {/* Color Presets */}\n            <div className=\"flex items-center justify-between text-xs\">\n              <span className=\"font-medium text-zinc-700 dark:text-zinc-300 flex items-center gap-1\">\n                <Palette className=\"w-3.5 h-3.5 text-blue-500\" />\n                Color Theme:\n              </span>\n              <div className=\"flex items-center gap-1.5\">\n                <button\n                  onClick={() => { setFgColor(\'#09090b\'); setBgColor(\'#ffffff\'); }}\n                  className=\"w-5 h-5 rounded-full bg-zinc-900 border border-zinc-300 cursor-pointer\"\n                  title=\"Dark / Light\"\n                />\n                <button\n                  onClick={() => { setFgColor(\'#2563eb\'); setBgColor(\'#eff6ff\'); }}\n                  className=\"w-5 h-5 rounded-full bg-blue-600 border border-zinc-300 cursor-pointer\"\n                  title=\"Electric Blue\"\n                />\n                <button\n                  onClick={() => { setFgColor(\'#ee4d2d\'); setBgColor(\'#fff7ed\'); }}\n                  className=\"w-5 h-5 rounded-full bg-orange-600 border border-zinc-300 cursor-pointer\"\n                  title=\"Shopee Orange\"\n                />\n                <button\n                  onClick={() => { setFgColor(\'#0d9488\'); setBgColor(\'#f0fdf4\'); }}\n                  className=\"w-5 h-5 rounded-full bg-teal-600 border border-zinc-300 cursor-pointer\"\n                  title=\"TikTok Teal\"\n                />\n              </div>\n            </div>\n\n            {/* Include Logo Toggle */}\n            <div className=\"flex items-center justify-between text-xs pt-1 border-t border-zinc-100 dark:border-zinc-800\">\n              <span className=\"font-medium text-zinc-700 dark:text-zinc-300 flex items-center gap-1\">\n                <ImageIcon className=\"w-3.5 h-3.5 text-blue-500\" />\n                Center Icon Badge:\n              </span>\n              <button\n                onClick={() => setIncludeLogo(!includeLogo)}\n                className={`px-2.5 py-1 rounded-md text-xs font-semibold transition-colors cursor-pointer ${\n                  includeLogo\n                    ? \'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20\'\n                    : \'bg-zinc-100 dark:bg-zinc-800 text-zinc-500\'\n                }`}\n              >\n                {includeLogo ? \'Enabled\' : \'Disabled\'}\n              </button>\n            </div>\n\n            {/* Download & Copy Buttons */}\n            <div className=\"grid grid-cols-2 gap-2 pt-2\">\n              <button\n                onClick={handleCopyUrl}\n                className=\"py-2.5 px-3 rounded-xl text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 transition-colors flex items-center justify-center gap-1.5 cursor-pointer\"\n              >\n                {copied ? <Check className=\"w-4 h-4 text-emerald-500\" /> : <Copy className=\"w-4 h-4\" />}\n                <span>{copied ? \'Copied Link\' : \'Copy Link\'}</span>\n              </button>\n\n              <button\n                onClick={handleDownloadPng}\n                className=\"py-2.5 px-3 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 transition-colors flex items-center justify-center gap-1.5 shadow-md shadow-blue-500/20 cursor-pointer\"\n              >\n                <Download className=\"w-4 h-4\" />\n                <span>Download PNG</span>\n              </button>\n            </div>\n          </div>\n        </motion.div>\n      </div>\n    </AnimatePresence>\n  );"
      }
      num_matches: 1
    }
  }
}
