      replacement_content: "import React, { useState } from \'react\';\nimport { \n  History, \n  Search, \n  Trash2, \n  Download, \n  Copy, \n  Check, \n  ExternalLink, \n  QrCode, \n  Filter, \n  Sparkles,\n  TrendingUp,\n  Tag\n} from \'lucide-react\';\nimport { ConvertedLink, PlatformType } from \'../types\';\nimport { PLATFORMS, copyToClipboard, formatCurrency } from \'../lib/utils\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface HistoryListProps {\n  history: ConvertedLink[];\n  onClearHistory: () => void;\n  onDeleteLink: (id: string) => void;\n  onOpenQrModal: (link: ConvertedLink) => void;\n}\n\nexport const HistoryList: React.FC<HistoryListProps> = ({\n  history,\n  onClearHistory,\n  onDeleteLink,\n  onOpenQrModal,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [filterPlatform, setFilterPlatform] = useState<PlatformType | \'all\'>(\'all\');\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const filtered = history.filter((item) => {\n    const matchesSearch =\n      item.title?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      item.originalUrl.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      item.subId.toLowerCase().includes(searchTerm.toLowerCase());\n    const matchesPlatform = filterPlatform === \'all\' || item.platform === filterPlatform;\n    return matchesSearch && matchesPlatform;\n  });\n\n  const totalCashbackEst = history.reduce((acc, curr) => acc + (curr.estimatedCashback || 0), 0);\n\n  const handleCopyShort = async (id: string, url: string) => {\n    const success = await copyToClipboard(url);\n    if (success) {\n      setCopiedId(id);\n      setTimeout(() => setCopiedId(null), 2000);\n    }\n  };\n\n  const handleExportCsv = () => {\n    if (history.length === 0) return;\n    const headers = [\'Platform\', \'Title\', \'Original URL\', \'Short Affiliate URL\', \'SubID\', \'Est Cashback ($)\', \'Commission Rate (%)\', \'Date\'];\n    const rows = history.map((h) => [\n      PLATFORMS[h.platform].name,\n      `\"${(h.title || \'Product\').replace(/\"/g, \'\"\"\')}\"`,\n      `\"${h.originalUrl}\"`,\n      `\"${h.shortUrl}\"`,\n      `\"${h.subId}\"`,\n      h.estimatedCashback || 0,\n      h.commissionRate || 0,\n      new Date(h.createdAt).toLocaleDateString(),\n    ]);\n\n    const csvContent = [headers.join(\',\'), ...rows.map((r) => r.join(\',\'))].join(\'\\n\');\n    const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.setAttribute(\'href\', url);\n    link.setAttribute(\'download\', `cashbacklink_history_${new Date().toISOString().slice(0, 10)}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  };\n\n  return (\n    <div className=\"w-full bg-white dark:bg-gray-900 rounded-2xl p-4 sm:p-6 shadow-xl border border-gray-200/80 dark:border-gray-800 space-y-4 transition-all\">\n      {/* Header Bar */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-gray-100 dark:border-gray-800\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"p-2 rounded-xl bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400\">\n            <History className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h3 className=\"font-bold text-base text-gray-900 dark:text-white flex items-center gap-2\">\n              Conversion History\n              <span className=\"text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 font-medium\">\n                {history.length} Saved\n              </span>\n            </h3>\n            <p className=\"text-xs text-gray-500 dark:text-gray-400\">\n              Stored locally in your browser cache\n            </p>\n          </div>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2\">\n          {history.length > 0 && (\n            <>\n              <button\n                onClick={handleExportCsv}\n                className=\"px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-700 transition-colors flex items-center gap-1 cursor-pointer\"\n                title=\"Export CSV\"\n              >\n                <Download className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Export CSV</span>\n              </button>\n\n              <button\n                onClick={onClearHistory}\n                className=\"px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 transition-colors flex items-center gap-1 cursor-pointer\"\n                title=\"Clear all history\"\n              >\n                <Trash2 className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Clear All</span>\n              </button>\n            </>\n          )}\n        </div>\n      </div>\n\n      {/* Stats Summary Bar */}\n      {history.length > 0 && (\n        <div className=\"p-3 rounded-xl bg-gradient-to-r from-orange-500/10 via-rose-500/10 to-indigo-500/10 border border-orange-200/60 dark:border-orange-900/40 flex items-center justify-between text-xs\">\n          <div className=\"flex items-center gap-2\">\n            <TrendingUp className=\"w-4 h-4 text-orange-500\" />\n            <span className=\"text-gray-700 dark:text-gray-300\">Total Est. Cashback Potential:</span>\n          </div>\n          <span className=\"font-extrabold text-sm text-gray-900 dark:text-white\">\n            {formatCurrency(totalCashbackEst)}\n          </span>\n        </div>\n      )}\n\n      {/* Filters & Search */}\n      {history.length > 0 && (\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-2.5\">\n          {/* Search Field */}\n          <div className=\"relative w-full sm:w-64\">\n            <Search className=\"w-3.5 h-3.5 text-gray-400 absolute left-3 top-2.5\" />\n            <input\n              type=\"text\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              placeholder=\"Search history by title, URL or SubID...\"\n              className=\"w-full py-1.5 pl-8 pr-3 text-xs rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-500/30\"\n            />\n          </div>\n\n          {/* Platform Filters */}\n          <div className=\"flex items-center gap-1 flex-wrap w-full sm:w-auto\">\n            <button\n              onClick={() => setFilterPlatform(\'all\')}\n              className={`px-2.5 py-1 rounded-lg text-xs font-medium transition-all ${\n                filterPlatform === \'all\'\n                  ? \'bg-gray-900 text-white dark:bg-white dark:text-gray-900 font-bold\'\n                  : \'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400\'\n              }`}\n            >\n              All\n            </button>\n            <button\n              onClick={() => setFilterPlatform(\'shopee\')}\n              className={`px-2.5 py-1 rounded-lg text-xs font-medium transition-all ${\n                filterPlatform === \'shopee\'\n                  ? \'bg-orange-600 text-white font-bold\'\n                  : \'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400\'\n              }`}\n            >\n              Shopee\n            </button>\n            <button\n              onClick={() => setFilterPlatform(\'tiktok\')}\n              className={`px-2.5 py-1 rounded-lg text-xs font-medium transition-all ${\n                filterPlatform === \'tiktok\'\n                  ? \'bg-teal-600 text-white font-bold\'\n                  : \'bg-teal-50 dark:bg-teal-950/40 text-teal-600 dark:text-teal-400\'\n              }`}\n            >\n              TikTok\n            </button>\n            <button\n              onClick={() => setFilterPlatform(\'lazada\')}\n              className={`px-2.5 py-1 rounded-lg text-xs font-medium transition-all ${\n                filterPlatform === \'lazada\'\n                  ? \'bg-indigo-600 text-white font-bold\'\n                  : \'bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400\'\n              }`}\n            >\n              Lazada\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* History Items List */}\n      <div className=\"space-y-2.5 max-h-[420px] overflow-y-auto pr-1\">\n        {history.length === 0 ? (\n          <div className=\"py-12 text-center text-gray-400 dark:text-gray-500 space-y-2\">\n            <History className=\"w-8 h-8 mx-auto opacity-40\" />\n            <p className=\"text-xs\">No converted links saved yet.</p>\n            <p className=\"text-[11px] text-gray-400\">Paste any Shopee, TikTok, or Lazada URL above to get started!</p>\n          </div>\n        ) : filtered.length === 0 ? (\n          <div className=\"py-8 text-center text-gray-400 dark:text-gray-500 text-xs\">\n            No history matched your search criteria.\n          </div>\n        ) : (\n          filtered.map((item) => {\n            const pInfo = PLATFORMS[item.platform];\n            return (\n              <motion.div\n                key={item.id}\n                layout\n                initial={{ opacity: 0 }}\n                animate={{ opacity: 1 }}\n                exit={{ opacity: 0 }}\n                className=\"p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800/50 border border-gray-200/60 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\"\n              >\n                {/* Product Title & Info */}\n                <div className=\"space-y-1 min-w-0 flex-1\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className={`px-2 py-0.5 rounded-md text-[10px] font-bold ${pInfo.bgLight} ${pInfo.bgDark} ${pInfo.textLight} ${pInfo.textDark}`}>\n                      {pInfo.name}\n                    </span>\n                    <span className=\"text-[11px] font-semibold text-emerald-600 dark:text-emerald-400\">\n                      +{formatCurrency(item.estimatedCashback || 0)} cashback\n                    </span>\n                    <span className=\"text-[10px] text-gray-400 dark:text-gray-500 hidden xs:inline\">\n                      \342\200\242 {new Date(item.createdAt).toLocaleDateString()}\n                    </span>\n                  </div>\n\n                  <p className=\"font-medium text-xs text-gray-900 dark:text-white truncate\">\n                    {item.title || item.originalUrl}\n                  </p>\n\n                  <div className=\"flex items-center gap-2 text-[11px] text-gray-500 dark:text-gray-400 font-mono\">\n                    <span className=\"text-orange-600 dark:text-orange-400 font-semibold\">{item.shortUrl}</span>\n                    <span>\342\200\242</span>\n                    <span className=\"truncate max-w-[150px] sm:max-w-[240px]\">SubID: {item.subId}</span>\n                  </div>\n                </div>\n\n                {/* Quick Actions */}\n                <div className=\"flex items-center gap-1.5 self-end sm:self-center shrink-0\">\n                  <button\n                    onClick={() => handleCopyShort(item.id, item.shortUrl)}\n                    className=\"p-2 rounded-lg bg-white dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 transition-colors shadow-2xs\"\n                    title=\"Copy Short Affiliate Link\"\n                  >\n                    {copiedId === item.id ? <Check className=\"w-3.5 h-3.5 text-emerald-500\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                  </button>\n\n                  <button\n                    onClick={() => onOpenQrModal(item)}\n                    className=\"p-2 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 hover:bg-indigo-100 dark:hover:bg-indigo-900 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800 transition-colors\"\n                    title=\"QR Code\"\n                  >\n                    <QrCode className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  <a\n                    href={item.affiliateUrl}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"p-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900 hover:bg-black dark:hover:bg-gray-100 transition-colors\"\n                    title=\"Open Link\"\n                  >\n                    <ExternalLink className=\"w-3.5 h-3.5\" />\n                  </a>\n\n                  <button\n                    onClick={() => onDeleteLink(item.id)}\n                    className=\"p-2 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors\"\n                    title=\"Delete item\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </motion.div>\n            );\n          })\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
