  file_change {
    absolute_path_uri: "file:///src/components/BatchConverter.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Layers, ArrowRight, Copy, Check, Download, RefreshCw, Zap, Tag } from \'lucide-react\';\nimport { ConvertedLink } from \'../types\';\nimport { detectPlatform, isValidUrl, generateAffiliateLink, PLATFORMS, copyToClipboard } from \'../lib/utils\';\nimport { motion } from \'motion/react\';\n\ninterface BatchConverterProps {\n  onAddBatchToHistory: (links: ConvertedLink[]) => void;\n}\n\nexport const BatchConverter: React.FC<BatchConverterProps> = ({ onAddBatchToHistory }) => {\n  const [rawText, setRawText] = useState(\'\');\n  const [subId, setSubId] = useState(\'batch_campaign\');\n  const [results, setResults] = useState<ConvertedLink[]>([]);\n  const [copied, setCopied] = useState(false);\n  const [isProcessing, setIsProcessing] = useState(false);\n\n  const handleProcessBatch = () => {\n    const lines = rawText.split(\'\\n\').map((l) => l.trim()).filter(Boolean);\n    if (lines.length === 0) return;\n\n    setIsProcessing(true);\n\n    setTimeout(() => {\n      const converted: ConvertedLink[] = lines.map((line, idx) => {\n        const platform = detectPlatform(line);\n        const generated = generateAffiliateLink(line, platform, subId);\n\n        return {\n          id: `batch_${Date.now()}_${idx}_${Math.random().toString(36).slice(2, 6)}`,\n          originalUrl: line,\n          normalizedUrl: generated.affiliateUrl.split(\'?\')[0],\n          affiliateUrl: generated.affiliateUrl,\n          shortUrl: generated.shortUrl,\n          platform: platform,\n          subId: subId || \'batch\',\n          createdAt: new Date().toISOString(),\n          title: generated.title,\n          estimatedPrice: generated.estimatedPrice,\n          estimatedCashback: generated.estimatedCashback,\n          commissionRate: generated.commissionRate,\n          category: generated.category,\n        };\n      });\n\n      setResults(converted);\n      onAddBatchToHistory(converted);\n      setIsProcessing(false);\n    }, 300);\n  };\n\n  const handleCopyAll = async () => {\n    if (results.length === 0) return;\n    const allShorts = results.map((r) => r.shortUrl).join(\'\\n\');\n    const success = await copyToClipboard(allShorts);\n    if (success) {\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2000);\n    }\n  };\n\n  return (\n    <div className=\"w-full bg-white dark:bg-gray-900 rounded-2xl p-4 sm:p-6 shadow-xl border border-gray-200/80 dark:border-gray-800 space-y-4 transition-all\">\n      <div className=\"flex items-center gap-2 pb-3 border-b border-gray-100 dark:border-gray-800\">\n        <div className=\"p-2 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-600 text-white\">\n          <Layers className=\"w-5 h-5\" />\n        </div>\n        <div>\n          <h3 className=\"font-bold text-base text-gray-900 dark:text-white flex items-center gap-2\">\n            Batch URL Converter\n            <span className=\"text-xs px-2 py-0.5 rounded-full bg-indigo-100 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 font-semibold border border-indigo-200 dark:border-indigo-800\">\n              Bulk Mode\n            </span>\n          </h3>\n          <p className=\"text-xs text-gray-500 dark:text-gray-400\">\n            Paste multiple Shopee, TikTok, or Lazada URLs (one URL per line) to convert them all at once.\n          </p>\n        </div>\n      </div>\n\n      <div className=\"space-y-3\">\n        {/* Text Area */}\n        <div>\n          <label className=\"block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1\">\n            Product URLs (One per line)\n          </label>\n          <textarea\n            rows={4}\n            value={rawText}\n            onChange={(e) => setRawText(e.target.value)}\n            placeholder={`https://shopee.vn/product/123/456\\nhttps://vt.tiktok.com/ZS2x9K8/\\nhttps://www.lazada.vn/products/i9082.html`}\n            className=\"w-full p-3 rounded-xl text-xs font-mono bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-500/40 resize-y\"\n          />\n        </div>\n\n        {/* Campaign SubID */}\n        <div className=\"flex items-center gap-2\">\n          <Tag className=\"w-4 h-4 text-gray-400 shrink-0\" />\n          <input\n            type=\"text\"\n            value={subId}\n            onChange={(e) => setSubId(e.target.value)}\n            placeholder=\"Campaign SubID (e.g., telegram_july_deals)\"\n            className=\"flex-1 py-1.5 px-3 text-xs rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none\"\n          />\n        </div>\n\n        {/* Process Button */}\n        <button\n          onClick={handleProcessBatch}\n          disabled={isProcessing || !rawText.trim()}\n          className=\"w-full py-3 px-4 rounded-xl font-bold text-xs text-white bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md shadow-indigo-600/20\"\n        >\n          {isProcessing ? (\n            <span>Processing Batch...</span>\n          ) : (\n            <>\n              <Zap className=\"w-4 h-4 text-amber-300\" />\n              <span>Convert All URLs in Batch</span>\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* Batch Results Output */}\n      {results.length > 0 && (\n        <motion.div\n          initial={{ opacity: 0, y: 10 }}\n          animate={{ opacity: 1, y: 0 }}\n          className=\"pt-4 border-t border-gray-100 dark:border-gray-800 space-y-3\"\n        >\n          <div className=\"flex items-center justify-between\">\n            <h4 className=\"font-bold text-xs text-gray-900 dark:text-white\">\n              Batch Conversion Results ({results.length} links)\n            </h4>\n            <button\n              onClick={handleCopyAll}\n              className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-orange-500 hover:bg-orange-600 text-white shadow-2xs flex items-center gap-1 transition-colors cursor-pointer\"\n            >\n              {copied ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span>{copied ? \'All Copied!\' : \'Copy All Short Links\'}</span>\n            </button>\n          </div>\n\n          <div className=\"space-y-2 max-h-60 overflow-y-auto\">\n            {results.map((res, i) => (\n              <div\n                key={i}\n                className=\"p-2.5 rounded-lg bg-gray-50 dark:bg-gray-800/60 border border-gray-200/60 dark:border-gray-700/60 text-xs font-mono flex items-center justify-between gap-2\"\n              >\n                <div className=\"truncate flex-1\">\n                  <span className=\"font-bold text-orange-600 dark:text-orange-400 mr-2\">\n                    [{PLATFORMS[res.platform].name}]\n                  </span>\n                  <span className=\"text-gray-900 dark:text-gray-100\">{res.shortUrl}</span>\n                </div>\n                <span className=\"text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold shrink-0\">\n                  +{res.commissionRate}%\n                </span>\n              </div>\n            ))}\n          </div>\n        </motion.div>\n      )}\n    </div>\n  );\n};\n"
    }
