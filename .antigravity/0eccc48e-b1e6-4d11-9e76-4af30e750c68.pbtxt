    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <motion.div\n      initial={{ opacity: 0, y: 12 }}\n      animate={{ opacity: 1, y: 0 }}\n      className=\"w-full bg-white dark:bg-gray-900 rounded-2xl p-5 sm:p-6 shadow-xl border border-gray-200/90 dark:border-gray-800 space-y-5 transition-all\"\n    >\n      {/* Top Banner: Success Header & Platform */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-gray-100 dark:border-gray-800\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0\">\n            <CheckCircle2 className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h3 className=\"font-bold text-base text-gray-900 dark:text-white flex items-center gap-1.5\">\n              Affiliate Link Ready\n              <span className=\"text-xs px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-semibold border border-emerald-200 dark:border-emerald-800\">\n                Normalized\n              </span>\n            </h3>\n            <p className=\"text-xs text-gray-500 dark:text-gray-400\">\n              Clean parameters applied & affiliate tracking ID attached\n            </p>\n          </div>\n        </div>\n\n        {/* Platform Badge */}\n        <div className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-bold text-xs ${platformInfo.bgLight} ${platformInfo.bgDark} ${platformInfo.textLight} ${platformInfo.textDark} border ${platformInfo.borderLight} ${platformInfo.borderDark}`}>\n          <span>{platformInfo.name}</span>\n        </div>\n      </div>\n\n      {/* Product Title & Estimated Cashback Metric Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n        {/* Product Info */}\n        <div className=\"md:col-span-2 p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800/60 border border-gray-200/60 dark:border-gray-700/60 flex flex-col justify-between\">\n          <div>\n            <span className=\"text-[11px] font-semibold uppercase text-gray-400 dark:text-gray-500 tracking-wider\">\n              Item Preview ({link.category || \'General\'})\n            </span>\n            <p className=\"font-semibold text-sm text-gray-900 dark:text-white line-clamp-2 mt-0.5\">\n              {link.title}\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2 mt-2 pt-2 border-t border-gray-200/40 dark:border-gray-700/40 text-xs text-gray-500 dark:text-gray-400\">\n            <Tag className=\"w-3.5 h-3.5 text-gray-400\" />\n            <span>SubID: <strong className=\"text-gray-800 dark:text-gray-200\">{link.subId}</strong></span>\n          </div>\n        </div>\n\n        {/* Estimated Cashback Metric Box */}\n        <div className=\"p-3.5 rounded-xl bg-gradient-to-br from-amber-500/10 via-orange-500/10 to-rose-500/10 dark:from-amber-950/30 dark:to-orange-950/30 border border-orange-200 dark:border-orange-800/40 flex flex-col justify-between\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-semibold text-orange-700 dark:text-orange-300\">\n              Est. Cashback Bonus\n            </span>\n            <TrendingUp className=\"w-4 h-4 text-orange-500\" />\n          </div>\n          <div className=\"my-1\">\n            <div className=\"text-2xl font-black text-gray-900 dark:text-white\">\n              {formatCurrency(link.estimatedCashback || 0)}\n            </div>\n            <div className=\"text-xs font-semibold text-orange-600 dark:text-orange-400 flex items-center gap-1\">\n              <Percent className=\"w-3 h-3\" />\n              <span>{link.commissionRate}% Commission Rate</span>\n            </div>\n          </div>\n          <span className=\"text-[10px] text-gray-400 dark:text-gray-500\">\n            Based on ~{formatCurrency(link.estimatedPrice || 25)} item estimate\n          </span>\n        </div>\n      </div>\n\n      {/* Main Affiliate Link Fields */}\n      <div className=\"space-y-3\">\n        {/* Short Link Display */}\n        <div>\n          <label className=\"block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1\">\n            Shortened Affiliate Link (Recommended for sharing)\n          </label>\n          <div className=\"flex items-center gap-2\">\n            <input\n              type=\"text\"\n              readOnly\n              value={link.shortUrl}\n              className=\"flex-1 py-2.5 px-3 rounded-lg text-xs font-mono font-semibold bg-gray-100 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-orange-600 dark:text-orange-400 select-all focus:outline-none\"\n            />\n            <button\n              onClick={() => handleCopy(link.shortUrl, \'short\')}\n              className={`px-3.5 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shrink-0 ${\n                copiedType === \'short\'\n                  ? \'bg-emerald-600 text-white shadow-xs\'\n                  : \'bg-orange-600 hover:bg-orange-700 text-white shadow-xs\'\n              }`}\n            >\n              {copiedType === \'short\' ? (\n                <>\n                  <Check className=\"w-4 h-4\" />\n                  <span>Copied!</span>\n                </>\n              ) : (\n                <>\n                  <Copy className=\"w-4 h-4\" />\n                  <span>Copy Short</span>\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* Full Normalized Link Display */}\n        <div>\n          <label className=\"block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1\">\n            Full Normalized Tracking URL\n          </label>\n          <div className=\"flex items-center gap-2\">\n            <input\n              type=\"text\"\n              readOnly\n              value={link.affiliateUrl}\n              className=\"flex-1 py-2 px-3 rounded-lg text-[11px] font-mono bg-gray-50 dark:bg-gray-800/60 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 select-all focus:outline-none truncate\"\n            />\n            <button\n              onClick={() => handleCopy(link.affiliateUrl, \'raw\')}\n              className=\"px-3 py-2 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-700 transition-colors shrink-0 flex items-center gap-1\"\n            >\n              {copiedType === \'raw\' ? <Check className=\"w-3.5 h-3.5 text-emerald-500\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span>Copy Full</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Action Toolbar Buttons */}\n      <div className=\"flex flex-wrap items-center gap-2 pt-2 border-t border-gray-100 dark:border-gray-800\">\n        {/* Open Link */}\n        <a\n          href={link.affiliateUrl}\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          className=\"flex-1 min-w-[120px] py-2.5 px-3 rounded-xl text-xs font-semibold bg-gray-900 hover:bg-black text-white dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100 transition-colors flex items-center justify-center gap-1.5\"\n        >\n          <ExternalLink className=\"w-3.5 h-3.5\" />\n          <span>Open Link \342\206\227</span>\n        </a>\n\n        {/* QR Code */}\n        <button\n          onClick={() => onOpenQrModal(link)}\n          className=\"flex-1 min-w-[120px] py-2.5 px-3 rounded-xl text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/60 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 transition-colors flex items-center justify-center gap-1.5 cursor-pointer\"\n        >\n          <QrCode className=\"w-3.5 h-3.5 text-indigo-500\" />\n          <span>QR Code Generator</span>\n        </button>\n      </div>\n\n      {/* Promotional Snippet Generator Collapsible Card */}\n      <div className=\"p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800/40 border border-gray-200/60 dark:border-gray-800 space-y-2\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-1.5 text-xs font-semibold text-gray-700 dark:text-gray-300\">\n            <FileText className=\"w-3.5 h-3.5 text-orange-500\" />\n            <span>Promotional Text Generator</span>\n          </div>\n          <div className=\"flex items-center bg-gray-200 dark:bg-gray-700 p-0.5 rounded-lg text-[11px]\">\n            <button\n              onClick={() => setActiveSnippetTab(\'standard\')}\n              className={`px-2 py-0.5 rounded-md transition-all ${\n                activeSnippetTab === \'standard\'\n                  ? \'bg-white dark:bg-gray-900 text-gray-900 dark:text-white font-semibold\'\n                  : \'text-gray-500 dark:text-gray-400\'\n              }`}\n            >\n              Standard\n            </button>\n            <button\n              onClick={() => setActiveSnippetTab(\'whatsapp\')}\n              className={`px-2 py-0.5 rounded-md transition-all ${\n                activeSnippetTab === \'whatsapp\'\n                  ? \'bg-white dark:bg-gray-900 text-gray-900 dark:text-white font-semibold\'\n                  : \'text-gray-500 dark:text-gray-400\'\n              }`}\n            >\n              WhatsApp/TG\n            </button>\n            <button\n              onClick={() => setActiveSnippetTab(\'social\')}\n              className={`px-2 py-0.5 rounded-md transition-all ${\n                activeSnippetTab === \'social\'\n                  ? \'bg-white dark:bg-gray-900 text-gray-900 dark:text-white font-semibold\'\n                  : \'text-gray-500 dark:text-gray-400\'\n              }`}\n            >\n              Social Post\n            </button>\n          </div>\n        </div>\n\n        <div className=\"relative\">\n          <textarea\n            readOnly\n            rows={3}\n            value={getSnippet()}\n            className=\"w-full p-2.5 text-xs font-mono bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg text-gray-800 dark:text-gray-200 focus:outline-none resize-none\"\n          />\n          <button\n            onClick={() => handleCopy(getSnippet(), \'snippet\')}\n            className=\"absolute right-2 bottom-3 px-2.5 py-1 rounded-md text-[11px] font-bold bg-orange-500 hover:bg-orange-600 text-white shadow-2xs flex items-center gap-1 transition-all cursor-pointer\"\n          >\n            {copiedType === \'snippet\' ? <Check className=\"w-3 h-3\" /> : <Copy className=\"w-3 h-3\" />}\n            <span>{copiedType === \'snippet\' ? \'Copied\' : \'Copy Text\'}</span>\n          </button>\n        </div>\n      </div>\n    </motion.div>\n  );"
      replacement_content: "  return (\n    <motion.div\n      initial={{ opacity: 0, y: 12 }}\n      animate={{ opacity: 1, y: 0 }}\n      className=\"w-full bg-white dark:bg-zinc-900 rounded-2xl p-5 sm:p-6 shadow-xl border border-zinc-200 dark:border-zinc-800 space-y-5 transition-all\"\n    >\n      {/* Top Banner: Success Header & Platform */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-zinc-100 dark:border-zinc-800\">\n        <div className=\"flex items-center gap-2.5\">\n          <div className=\"w-8 h-8 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20\">\n            <CheckCircle2 className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h3 className=\"font-bold text-base text-zinc-900 dark:text-white flex items-center gap-2\">\n              Affiliate Link Generated\n              <span className=\"text-xs px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold border border-emerald-500/20\">\n                Normalized\n              </span>\n            </h3>\n            <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">\n              Tracking ID and clean URL parameters attached successfully.\n            </p>\n          </div>\n        </div>\n\n        {/* Platform Badge */}\n        <div className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-bold text-xs ${platformInfo.bgLight} ${platformInfo.bgDark} ${platformInfo.textLight} ${platformInfo.textDark} border ${platformInfo.borderLight} ${platformInfo.borderDark}`}>\n          <span>{platformInfo.name}</span>\n        </div>\n      </div>\n\n      {/* Product Title & Estimated Cashback Metric Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n        {/* Product Info */}\n        <div className=\"md:col-span-2 p-3.5 rounded-xl bg-zinc-50 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-800 flex flex-col justify-between\">\n          <div>\n            <span className=\"text-[11px] font-bold uppercase text-zinc-400 dark:text-zinc-500 tracking-wider\">\n              Item Preview ({link.category || \'General\'})\n            </span>\n            <p className=\"font-semibold text-sm text-zinc-900 dark:text-white line-clamp-2 mt-0.5\">\n              {link.title}\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2 mt-2 pt-2 border-t border-zinc-200/60 dark:border-zinc-800 text-xs text-zinc-500 dark:text-zinc-400 font-mono\">\n            <Tag className=\"w-3.5 h-3.5 text-zinc-400\" />\n            <span>SubID / Tag: <strong className=\"text-zinc-800 dark:text-zinc-200\">{link.subId}</strong></span>\n          </div>\n        </div>\n\n        {/* Estimated Cashback Metric Box */}\n        <div className=\"p-3.5 rounded-xl bg-gradient-to-br from-blue-500/10 via-indigo-500/10 to-emerald-500/10 dark:from-blue-950/40 dark:to-indigo-950/40 border border-blue-500/20 flex flex-col justify-between\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-bold text-blue-600 dark:text-blue-400\">\n              Est. Cashback Earnings\n            </span>\n            <TrendingUp className=\"w-4 h-4 text-blue-500\" />\n          </div>\n          <div className=\"my-1\">\n            <div className=\"text-2xl font-black text-zinc-900 dark:text-white\">\n              {formatCurrency(link.estimatedCashback || 0)}\n            </div>\n            <div className=\"text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1\">\n              <Percent className=\"w-3 h-3\" />\n              <span>{link.commissionRate}% Commission Rate</span>\n            </div>\n          </div>\n          <span className=\"text-[10px] text-zinc-400 dark:text-zinc-500\">\n            Based on ~{formatCurrency(link.estimatedPrice || 25)} item estimate\n          </span>\n        </div>\n      </div>\n\n      {/* Main Affiliate Link Fields */}\n      <div className=\"space-y-3\">\n        {/* Short Link Display */}\n        <div>\n          <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1\">\n            Shortened Affiliate Link (Recommended for social sharing)\n          </label>\n          <div className=\"flex items-center gap-2\">\n            <input\n              type=\"text\"\n              readOnly\n              value={link.shortUrl}\n              className=\"flex-1 py-2.5 px-3 rounded-lg text-xs font-mono font-bold bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-blue-600 dark:text-blue-400 select-all focus:outline-none\"\n            />\n            <button\n              onClick={() => handleCopy(link.shortUrl, \'short\')}\n              className={`px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shrink-0 ${\n                copiedType === \'short\'\n                  ? \'bg-emerald-600 text-white shadow-xs\'\n                  : \'bg-blue-600 hover:bg-blue-700 text-white shadow-xs\'\n              }`}\n            >\n              {copiedType === \'short\' ? (\n                <>\n                  <Check className=\"w-4 h-4\" />\n                  <span>Copied!</span>\n                </>\n              ) : (\n                <>\n                  <Copy className=\"w-4 h-4\" />\n                  <span>Copy Short</span>\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* Full Normalized Link Display */}\n        <div>\n          <label className=\"block text-xs font-medium text-zinc-500 dark:text-zinc-400 mb-1\">\n            Full Normalized Tracking URL\n          </label>\n          <div className=\"flex items-center gap-2\">\n            <input\n              type=\"text\"\n              readOnly\n           