tory Items List */}\n      <div className=\"space-y-2.5 max-h-[420px] overflow-y-auto pr-1\">\n        {history.length === 0 ? (\n          <div className=\"py-12 text-center text-gray-400 dark:text-gray-500 space-y-2\">\n            <History className=\"w-8 h-8 mx-auto opacity-40\" />\n            <p className=\"text-xs\">No converted links saved yet.</p>\n            <p className=\"text-[11px] text-gray-400\">Paste any Shopee, TikTok, or Lazada URL above to get started!</p>\n          </div>\n        ) : filtered.length === 0 ? (\n          <div className=\"py-8 text-center text-gray-400 dark:text-gray-500 text-xs\">\n            No history matched your search criteria.\n          </div>\n        ) : (\n          filtered.map((item) => {\n            const pInfo = PLATFORMS[item.platform];\n            return (\n              <motion.div\n                key={item.id}\n                layout\n                initial={{ opacity: 0 }}\n                animate={{ opacity: 1 }}\n                exit={{ opacity: 0 }}\n                className=\"p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800/50 border border-gray-200/60 dark:border-gray-700/60 hover:border-gray-300 dark:hover:border-gray-600 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\"\n              >\n                {/* Product Title & Info */}\n                <div className=\"space-y-1 min-w-0 flex-1\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className={`px-2 py-0.5 rounded-md text-[10px] font-bold ${pInfo.bgLight} ${pInfo.bgDark} ${pInfo.textLight} ${pInfo.textDark}`}>\n                      {pInfo.name}\n                    </span>\n                    <span className=\"text-[11px] font-semibold text-emerald-600 dark:text-emerald-400\">\n                      +{formatCurrency(item.estimatedCashback || 0)} cashback\n                    </span>\n                    <span className=\"text-[10px] text-gray-400 dark:text-gray-500 hidden xs:inline\">\n                      \342\200\242 {new Date(item.createdAt).toLocaleDateString()}\n                    </span>\n                  </div>\n\n                  <p className=\"font-medium text-xs text-gray-900 dark:text-white truncate\">\n                    {item.title || item.originalUrl}\n                  </p>\n\n                  <div className=\"flex items-center gap-2 text-[11px] text-gray-500 dark:text-gray-400 font-mono\">\n                    <span className=\"text-orange-600 dark:text-orange-400 font-semibold\">{item.shortUrl}</span>\n                    <span>\342\200\242</span>\n                    <span className=\"truncate max-w-[150px] sm:max-w-[240px]\">SubID: {item.subId}</span>\n                  </div>\n                </div>\n\n                {/* Quick Actions */}\n                <div className=\"flex items-center gap-1.5 self-end sm:self-center shrink-0\">\n                  <button\n                    onClick={() => handleCopyShort(item.id, item.shortUrl)}\n                    className=\"p-2 rounded-lg bg-white dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 transition-colors shadow-2xs\"\n                    title=\"Copy Short Affiliate Link\"\n                  >\n                    {copiedId === item.id ? <Check className=\"w-3.5 h-3.5 text-emerald-500\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                  </button>\n\n                  <button\n                    onClick={() => onOpenQrModal(item)}\n                    className=\"p-2 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 hover:bg-indigo-100 dark:hover:bg-indigo-900 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800 transition-colors\"\n                    title=\"QR Code\"\n                  >\n                    <QrCode className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  <a\n                   