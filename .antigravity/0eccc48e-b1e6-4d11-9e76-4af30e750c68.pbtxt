        lines {
          text: "    const headers = [\'Platform\', \'Title\', \'Original URL\', \'Short Affiliate URL\', \'SubID\', \'Est Cashback ($)\', \'Commission Rate (%)\', \'Date\'];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
