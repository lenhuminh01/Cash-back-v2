    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Sun, Moon, Monitor, Sparkles, Link2, TrendingUp, HelpCircle } from \'lucide-react\';\nimport { ThemeMode } from \'../types\';\n\ninterface HeaderProps {\n  theme: ThemeMode;\n  setTheme: (theme: ThemeMode) => void;\n  convertedCount: number;\n  onOpenRatesGuide: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({ theme, setTheme, convertedCount, onOpenRatesGuide }) => {\n  return (\n    <header className=\"sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 dark:bg-gray-950/80 border-b border-gray-200/80 dark:border-gray-800/80 transition-colors\">\n      <div className=\"max-w-5xl mx-auto px-4 h-16 flex items-center justify-between gap-2\">\n        {/* Brand */}\n        <div className=\"flex items-center gap-2.5\">\n          <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-500 via-rose-500 to-indigo-600 p-0.5 shadow-md shadow-orange-500/10 flex items-center justify-center\">\n            <div className=\"w-full h-full bg-white dark:bg-gray-900 rounded-[10px] flex items-center justify-center\">\n              <Link2 className=\"w-5 h-5 text-orange-600 dark:text-orange-400 transform -rotate-45\" />\n            </div>\n          </div>\n          <div>\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"font-extrabold text-lg tracking-tight bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 dark:from-white dark:via-gray-100 dark:to-gray-300 bg-clip-text text-transparent\">\n                Cashback<span className=\"text-orange-600 dark:text-orange-400\">Link</span>\n              </span>\n              <span className=\"px-1.5 py-0.5 text-[10px] font-semibold tracking-wide uppercase bg-orange-100 dark:bg-orange-950/60 text-orange-700 dark:text-orange-300 rounded-full border border-orange-200 dark:border-orange-800/50\">\n                MVP\n              </span>\n            </div>\n            <p className=\"text-xs text-gray-500 dark:text-gray-400 hidden sm:block\">\n              Shopee \342\200\242 TikTok Shop \342\200\242 Lazada Affiliate Converter\n            </p>\n          </div>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2\">\n          {/* Rates Guide Button */}\n          <button\n            onClick={onOpenRatesGuide}\n            className=\"flex items-center gap-1.5 text-xs font-medium px-2.5 py-1.5 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors border border-gray-200 dark:border-gray-800\"\n            title=\"View Commission & Cashback Rates\"\n          >\n            <TrendingUp className=\"w-3.5 h-3.5 text-orange-500\" />\n            <span className=\"hidden xs:inline\">Commission Rates</span>\n          </button>\n\n          {/* Theme Selector */}\n          <div className=\"flex items-center bg-gray-100 dark:bg-gray-900 p-1 rounded-lg border border-gray-200 dark:border-gray-800\">\n            <button\n              onClick={() => setTheme(\'light\')}\n              className={`p-1.5 rounded-md transition-all ${\n                theme === \'light\'\n                  ? \'bg-white dark:bg-gray-800 text-amber-500 shadow-xs font-semibold\'\n                  : \'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300\'\n              }`}\n              title=\"Light Mode\"\n              aria-label=\"Light mode\"\n            >\n              <Sun className=\"w-3.5 h-3.5\" />\n            </button>\n            <button\n              onClick={() => setTheme(\'dark\')}\n              className={`p-1.5 rounded-md transition-all ${\n                theme === \'dark\'\n                  ? \'bg-white dark:bg-gray-800 text-indigo-400 shadow-xs font-semibold\'\n                  : \'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300\'\n              }`}\n              title=\"Dark Mode\"\n              aria-label=\"Dark mode\"\n            >\n              <Moon className=\"w-3.5 h-3.5\" />\n            </button>\n            <button\n              onClick={() => setTheme(\'system\')}\n              className={`p-1.5 rounded-md transition-all ${\n                theme === \'system\'\n                  ? \'bg-white dark:bg-gray-800 text-orange-500 shadow-xs font-semibold\'\n                  : \'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300\'\n              }`}\n              title=\"System Theme\"\n              aria-label=\"System theme\"\n            >\n              <Monitor className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Sun, Moon, Monitor, Link2, TrendingUp } from \'lucide-react\';\nimport { ThemeMode } from \'../types\';\n\ninterface HeaderProps {\n  theme: ThemeMode;\n  setTheme: (theme: ThemeMode) => void;\n  convertedCount: number;\n  onOpenRatesGuide: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({ theme, setTheme, onOpenRatesGuide }) => {\n  return (\n    <header className=\"sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 dark:bg-zinc-950/80 border-b border-zinc-200 dark:border-zinc-800/80 transition-colors\">\n      <div className=\"max-w-5xl mx-auto px-4 h-16 flex items-center justify-between gap-2\">\n        {/* Brand */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-emerald-500 p-0.5 shadow-md shadow-blue-500/10 flex items-center justify-center\">\n            <div className=\"w-full h-full bg-white dark:bg-zinc-950 rounded-[10px] flex items-center justify-center\">\n              <Link2 className=\"w-4 h-4 text-blue-600 dark:text-blue-400 transform -rotate-45\" />\n            </div>\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-black text-lg tracking-tight text-zinc-900 dark:text-white\">\n                Cashback <span className=\"text-blue-600 dark:text-blue-500\">Link</span>\n              </span>\n              <span className=\"px-2 py-0.5 text-[10px] font-bold tracking-wider uppercase bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-full border border-blue-500/20\">\n                MVP v1.0\n              </span>\n            </div>\n            <p className=\"text-xs text-zinc-500 dark:text-zinc-400 hidden sm:block\">\n              Shopee \342\200\242 TikTok Shop \342\200\242 Lazada Affiliate Converter\n            </p>\n          </div>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2\">\n          {/* Rates Guide Button */}\n          <button\n            onClick={onOpenRatesGuide}\n            className=\"flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-xl text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-all border border-zinc-200 dark:border-zinc-800 cursor-pointer\"\n            title=\"View Commission & Cashback Rates\"\n          >\n            <TrendingUp className=\"w-3.5 h-3.5 text-blue-500\" />\n            <span className=\"hidden xs:inline\">Commission Rates</span>\n          </button>\n\n          {/* Theme Selector */}\n          <div className=\"flex items-center bg-zinc-100 dark:bg-zinc-900/90 p-1 rounded-xl border border-zinc-200 dark:border-zinc-800\">\n            <button\n              onClick={() => setTheme(\'light\')}\n              className={`p-1.5 rounded-lg transition-all cursor-pointer ${\n                theme === \'light\'\n                  ? \'bg-white text-amber-500 shadow-xs font-semibold\'\n                  : \'text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300\'\n              }`}\n              title=\"Light Mode\"\n              aria-label=\"Light mode\"\n            >\n              <Sun className=\"w-3.5 h-3.5\" />\n            </button>\n            <button\n              onClick={() => setTheme(\'dark\')}\n              className={`p-1.5 rounded-lg transition-all cursor-pointer ${\n                theme === \'dark\'\n                  ? \'bg-zinc-800 text-blue-400 shadow-xs font-semibold\'\n                  : \'text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300\'\n              }`}\n              title=\"Dark Mode\"\n              aria-label=\"Dark mode\"\n            >\n              <Moon className=\"w-3.5 h-3.5\" />\n            </button>\n            <button\n              onClick={() => setTheme(\'system\')}\n              className={`p-1.5 rounded-lg transition-all cursor-pointer ${\n                theme === \'system\'\n                  ? \'bg-white dark:bg-zinc-800 text-blue-500 shadow-xs font-semibold\'\n                  : \'text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300\'\n              }`}\n              title=\"System Theme\"\n              aria-label=\"System theme\"\n            >\n              <Monitor className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
    }
